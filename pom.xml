<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.nf3t</groupId>
  <artifactId>flow-tester</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>flow-tester</name>
  <description>CLI for running a NiFi flow definition against test input, for CI/CD pipelines that build custom processors and want to catch a broken flow before it ships.</description>
  <url>https://nf3t.com</url>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- NiFi 2.x is the current major line (Java 21+). Bump this to match
         the NiFi API version your target NAR was built against. -->
    <nifi.version>2.11.0</nifi.version>
    <picocli.version>4.7.6</picocli.version>
    <jackson.version>2.17.2</jackson.version>
    <slf4j.version>2.0.13</slf4j.version>
    <jsonschema-generator.version>4.37.0</jsonschema-generator.version>
  </properties>

  <dependencies>
    <!-- NiFi extension API: Processor, Relationship, PropertyDescriptor, etc. -->
    <dependency>
      <groupId>org.apache.nifi</groupId>
      <artifactId>nifi-api</artifactId>
      <version>${nifi.version}</version>
    </dependency>

    <!-- NiFi's official unit-testing harness: TestRunner / TestRunners / MockFlowFile -->
    <dependency>
      <groupId>org.apache.nifi</groupId>
      <artifactId>nifi-mock</artifactId>
      <version>${nifi.version}</version>
    </dependency>

    <!-- FlowFileUnpackagerV3: reads the input file as a FlowFile Package V3 file (attributes + content, possibly several) -->
    <dependency>
      <groupId>org.apache.nifi</groupId>
      <artifactId>nifi-flowfile-packager</artifactId>
      <version>${nifi.version}</version>
    </dependency>

    <!-- CLI argument parsing -->
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
      <version>${picocli.version}</version>
    </dependency>

    <!-- Flow definition JSON parsing, require-output parsing, and attribute output -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- nifi-api pulls in an slf4j binding requirement; keep logging simple -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <!-- flow-schema: generates the JSON Schema for a flow definition file straight
         from org.apache.nifi.flow.VersionedExternalFlow via reflection, so it stays
         in sync with whatever nifi.version is actually on the classpath. -->
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-generator</artifactId>
      <version>${jsonschema-generator.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-module-jackson</artifactId>
      <version>${jsonschema-generator.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>flow-tester</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.nf3t.flowtester.Main</mainClass>
                </transformer>
              </transformers>
              <!-- Drop signature files from shaded dependency jars to avoid
                   "Invalid signature file" errors at runtime. -->
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
